{
  "uid": "shift-happens-kubernetes-rollout",
  "title": "Shift Happens \u2014 Kubernetes rollout & live logs",
  "tags": [
    "shift-happens",
    "kubernetes",
    "rollout",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_pod_labels{namespace=\"shift-happens\",label_version=~\".+\"}, label_app)",
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "current": {
          "text": "identity-service",
          "value": "identity-service"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Rollouts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "rolling-update"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pods by version \u2014 $deployment",
      "description": "Running pods grouped by the version label on the pod template. The baseline is 3 x v1.0.0; the pause shows 3 x v1.0.0 + 1 x v1.0.1; after resume the old ReplicaSet is removed and only v1.0.1 remains.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (label_version) (kube_pod_labels{namespace=\"shift-happens\",label_app=\"$deployment\",label_version=~\"v1\\\\.0\\\\..*\"} * on (pod) group_left() (kube_pod_status_phase{namespace=\"shift-happens\",phase=\"Running\"} == 1)) or label_replace(vector(0), \"label_version\", \"v1.0.0\", \"\", \"\") or label_replace(vector(0), \"label_version\", \"v1.0.1\", \"\", \"\")",
          "legendFormat": "{{label_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 65,
            "showPoints": "always",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Replica state \u2014 $deployment",
      "description": "Deployment status from kube-state-metrics. The total pod count can rise to 4 while the old v1.0.0 pods and the new v1.0.1 pod overlap; it returns to 3 after the old ReplicaSet is removed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_deployment_spec_replicas{namespace=\"shift-happens\",deployment=\"$deployment\"})",
          "legendFormat": "desired"
        },
        {
          "refId": "B",
          "expr": "max(kube_deployment_status_replicas_ready{namespace=\"shift-happens\",deployment=\"$deployment\"})",
          "legendFormat": "ready"
        },
        {
          "refId": "C",
          "expr": "max(kube_deployment_status_replicas_updated{namespace=\"shift-happens\",deployment=\"$deployment\"})",
          "legendFormat": "updated (new version)"
        },
        {
          "refId": "D",
          "expr": "max(kube_deployment_status_replicas_unavailable{namespace=\"shift-happens\",deployment=\"$deployment\"})",
          "legendFormat": "unavailable"
        },
        {
          "refId": "E",
          "expr": "max(kube_deployment_status_replicas{namespace=\"shift-happens\",deployment=\"$deployment\"})",
          "legendFormat": "pods (old + new)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Live logs \u2014 identity-service + workforce-service",
      "description": "Request logs from the two services. The correlation id is added by CorrelationIdFilter and is visible in the log line when the logging pattern is applied.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"identity-service|workforce-service\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
