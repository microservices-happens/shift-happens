<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fallback Maven settings used by .github/actions/maven-build on the second and third attempt.

  The mirror points the `central` repository at the alternate Maven Central hostname. Both hostnames
  serve the same content, but they are separate CDN entry points, which is what helps when
  https://repo.maven.apache.org/maven2 answers a transient "403 Forbidden" to a shared runner IP.

  Because settings are read before the project POM, the mirror also covers parent POM resolution
  (the failure we saw on windows-latest was exactly that: the spring-boot-starter-parent POM).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
    <mirrors>
        <mirror>
            <id>central-alternate-host</id>
            <name>Maven Central (repo1 host)</name>
            <url>https://repo1.maven.org/maven2</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>
</settings>
