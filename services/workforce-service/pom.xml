<?xml version="1.0" encoding="UTF-8"?>
<!-- Standalone build (no shared parent across services) so each service is independently deployable. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.10</version>
        <relativePath/>
    </parent>

    <groupId>dk.ek.shift_happens</groupId>
    <artifactId>workforce-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>workforce-service</name>
    <description>Employees, contracts, departments, job roles, locations</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Walking skeleton: add starters as the service is implemented
         (data-jpa/data-mongodb, flyway, amqp, security + oauth2-resource-server, graphql, validation,
         springdoc-openapi, testcontainers). -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
