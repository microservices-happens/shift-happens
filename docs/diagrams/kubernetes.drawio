        <mxCell id="leave-read-db" value="&lt;b&gt;leave-read-db&lt;/b&gt;&lt;br&gt;mongo:8.0&lt;br&gt;Svc :27017 · PVC" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="990" y="470" width="130" height="95" as="geometry"/></mxCell>
        <mxCell id="notification-db" value="&lt;b&gt;notification-db&lt;/b&gt;&lt;br&gt;postgres:17-alpine&lt;br&gt;Svc :5432 · PVC" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1200" y="470" width="130" height="95" as="geometry"/></mxCell>
        <mxCell id="audit-db" value="&lt;b&gt;audit-db&lt;/b&gt;&lt;br&gt;postgres:17-alpine&lt;br&gt;Svc :5432 · PVC" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1385" y="470" width="130" height="95" as="geometry"/></mxCell>
        <mxCell id="ai-db" value="&lt;b&gt;ai-db&lt;/b&gt;&lt;br&gt;postgres:17-alpine&lt;br&gt;Svc :5432 · PVC" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1755" y="470" width="130" height="95" as="geometry"/></mxCell>
        <mxCell id="mailpit" value="&lt;b&gt;mailpit&lt;/b&gt; · v1.21&lt;br&gt;Svc mailpit :1025/:8025&lt;br&gt;Svc mailpit-ui &lt;b&gt;NodePort 30025&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1570" y="470" width="130" height="95" as="geometry"/></mxCell>
        <mxCell id="rabbitmq" value="&lt;b&gt;rabbitmq&lt;/b&gt; · rabbitmq:4.1-management-alpine · Svc rabbitmq ClusterIP :5672 / :15672 · Svc rabbitmq-management &lt;b&gt;NodePort 31672&lt;/b&gt; · PVC rabbitmq-pvc · Secret rabbitmq-secrets" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="625" width="1885" height="70" as="geometry"/></mxCell>
        <mxCell id="ollama" value="&lt;b&gt;ollama&lt;/b&gt; · ollama/ollama:0.12.3&lt;br&gt;Svc ClusterIP :11434&lt;br&gt;emptyDir models&lt;br&gt;(model: kubectl exec … ollama pull)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1980" y="290" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="otel-collector" value="&lt;b&gt;otel-collector&lt;/b&gt; · contrib:0.136.0&lt;br&gt;Svc ClusterIP :4317 / :4318&lt;br&gt;ConfigMap otel-collector-config → /etc/otelcol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="720" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="cm" value="&lt;b&gt;ConfigMap service-env&lt;/b&gt; (shared/configmap.yaml)&lt;br&gt;RabbitMQ host/user/vhost, exchanges, JWT issuer + JWKS URL, OTLP endpoint&lt;br&gt;envFrom: the 9 service Deployments (not frontend, not email-function)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;size=14;" parent="1" vertex="1"><mxGeometry x="400" y="720" width="520" height="75" as="geometry"/></mxCell>
        <mxCell id="pv" value="&lt;b&gt;10 PersistentVolumes + PVCs&lt;/b&gt; (&amp;lt;name&amp;gt;/pv.yaml): the 9 databases and rabbitmq&lt;br&gt;hostPath /var/lib/shift-happens/&amp;lt;name&amp;gt; · storageClassName manual · 1Gi · Retain" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;size=14;" parent="1" vertex="1"><mxGeometry x="950" y="720" width="520" height="75" as="geometry"/></mxCell>
        <mxCell id="secrets" value="&lt;b&gt;11 Secrets&lt;/b&gt;, created by kubernetes/secrets/create-secrets.sh from git-ignored files (never committed); a service and its database Deployment read the same Secret:&lt;br&gt;identity-service-secrets (identity-service, identity-db; also the JWT key as a mounted file) · workforce-service-secrets · scheduling-command-secrets (+ scheduling-write-db) · scheduling-query-secrets (+ scheduling-read-db) · leave-command-secrets (+ leave-write-db) · leave-query-secrets (+ leave-read-db) · notification-service-secrets · audit-service-secrets · ai-service-secrets · email-function-secrets · rabbitmq-secrets" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;size=14;" parent="1" vertex="1"><mxGeometry x="40" y="815" width="1430" height="75" as="geometry"/></mxCell>
        <mxCell id="netnote" value="No Ingress, HPA, KEDA object or NetworkPolicy exists in kubernetes/: the Compose internal networks are not reproduced, all pods can reach each other. Readiness probes only (no liveness): GET /health on the services and frontend, pg_isready / mongosh / rabbitmq-diagnostics on the data stores, /api/tags on ollama; none on api-gateway, mailpit, otel-collector, email-function." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="40" y="925" width="1430" height="50" as="geometry"/></mxCell>
        <mxCell id="planned" value="&lt;b&gt;Planned — not in kubernetes/ on main&lt;/b&gt;&lt;br&gt;• ingress-nginx Ingress replacing the NodePort gateway, and KEDA (#65)&lt;br&gt;• HPA on the query roles, KEDA ScaledObject, KEDA ScaledJob for email-function (#67)&lt;br&gt;• Prometheus, Loki, Tempo, Grafana behind otel-collector (#68)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;dashPattern=8 4;fontColor=#777777;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="1500" y="720" width="700" height="100" as="geometry"/></mxCell>
        <mxCell id="k8sdir" value="Drawn from &lt;b&gt;kubernetes/&lt;/b&gt;. The older Kustomize scaffold in &lt;b&gt;k8s/&lt;/b&gt; is not deployed; issue #64 decides which folder stays." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1500" y="835" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="ghcr" value="&lt;b&gt;GitHub Container Registry&lt;/b&gt; (public)&lt;br&gt;ghcr.io/microservices-happens/&amp;lt;image&amp;gt;:main · imagePullPolicy Always&lt;br&gt;identity-, workforce-, scheduling-, leave-, notification-, audit-, ai-service, email-function, frontend&lt;br&gt;pushed by the ci workflow on main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="300" y="1060" width="620" height="85" as="geometry"/></mxCell>
        <mxCell id="dockerhub" value="&lt;b&gt;Docker Hub&lt;/b&gt; · imagePullPolicy IfNotPresent (ollama: default)&lt;br&gt;postgres:17-alpine, mongo:8.0, rabbitmq:4.1-management-alpine, caddy:2-alpine, axllent/mailpit:v1.21, otel/opentelemetry-collector-contrib:0.136.0, ollama/ollama:0.12.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="960" y="1060" width="640" height="85" as="geometry"/></mxCell>
