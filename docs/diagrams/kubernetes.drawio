<mxfile host="drawio">
  <diagram id="shift-happens-kubernetes" name="Kubernetes">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
