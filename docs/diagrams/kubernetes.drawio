        <mxCell id="title" value="Shift Happens — local Kubernetes deployment (kubernetes/ manifests)" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="300" y="-95" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="g-cluster" value="&lt;b&gt;Docker Desktop Kubernetes&lt;/b&gt; · namespace &lt;i&gt;default&lt;/i&gt; · kubectl apply -R -f kubernetes/ · every workload is a Deployment with replicas: 1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#326ce5;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;labelBackgroundColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="95" width="2210" height="920" as="geometry"/></mxCell>
        <mxCell id="g-sched" value="GHCR &lt;b&gt;scheduling-service:main&lt;/b&gt; · 2 Deployments" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;labelBackgroundColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="410" y="252" width="375" height="152" as="geometry"/></mxCell>
        <mxCell id="g-leave" value="GHCR &lt;b&gt;leave-service:main&lt;/b&gt; · 2 Deployments" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;labelBackgroundColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="800" y="252" width="375" height="152" as="geometry"/></mxCell>
        <mxCell id="browser" value="&lt;b&gt;Browser on the host&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="720" y="-40" width="220" height="45" as="geometry"/></mxCell>
        <mxCell id="api-gateway" value="&lt;b&gt;api-gateway&lt;/b&gt; · caddy:2-alpine&lt;br&gt;Service &lt;b&gt;NodePort 30443&lt;/b&gt; → 443&lt;br&gt;ConfigMap api-gateway-caddyfile → /etc/caddy · emptyDir /data, /config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1"><mxGeometry x="620" y="120" width="420" height="80" as="geometry"/></mxCell>
