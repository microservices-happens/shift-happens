        <mxCell id="browser-gw" value="https://localhost:8443 (127.0.0.1:8443 → 443)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="browser" target="api-gateway" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
