<mxfile host="drawio">
  <diagram id="shift-happens-cicd" name="CI/CD">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Shift Happens — CI/CD pipelines (GitHub Actions, .github/workflows/)" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="200" y="-70" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="g-ci" value="&lt;b&gt;ci.yml&lt;/b&gt; — workflow &lt;i&gt;ci&lt;/i&gt; · concurrency per ref, cancel-in-progress" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;labelBackgroundColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="0" width="1860" height="690" as="geometry"/></mxCell>
        <mxCell id="t-ci" value="&lt;b&gt;on&lt;/b&gt;&lt;br&gt;pull_request&lt;br&gt;push: main&lt;br&gt;workflow_dispatch&lt;br&gt;(services = all | auto | list)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="230" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="changes" value="&lt;b&gt;detect changes&lt;/b&gt;&lt;br&gt;dorny/paths-filter&lt;br&gt;service matrix: services/&amp;lt;svc&amp;gt;/** or contracts/**&lt;br&gt;(7 services + email-function)&lt;br&gt;flags: contracts/**, frontend/**&lt;br&gt;manual run: input replaces the filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="260" y="215" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="tests" value="&lt;b&gt;tests (matrix: changed services)&lt;/b&gt;&lt;br&gt;mvn -B verify: unit tests (Surefire) + integration tests (Failsafe, Testcontainers)&lt;br&gt;artifact reports-&amp;lt;svc&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="570" y="40" width="400" height="85" as="geometry"/></mxCell>
        <mxCell id="images" value="&lt;b&gt;image (matrix: changed services)&lt;/b&gt;&lt;br&gt;docker build (named build context &lt;i&gt;contracts&lt;/i&gt;) → Trivy scan CRITICAL,HIGH (report-only unless TRIVY_EXIT_CODE=1)&lt;br&gt;&lt;b&gt;main only:&lt;/b&gt; QEMU, log in to GHCR, push linux/amd64 + linux/arm64 as :&amp;lt;sha&amp;gt; and :main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="570" y="145" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="contracts" value="&lt;b&gt;contracts&lt;/b&gt;&lt;br&gt;Redocly lint OpenAPI · AsyncAPI validate · AsyncAPI HTML → artifact asyncapi-html · GraphQL schema build · JSON Schemas (ajv)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="570" y="275" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="frontend" value="&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;npm ci → lint → typecheck → build&lt;br&gt;&lt;b&gt;main only:&lt;/b&gt; push frontend image amd64 + arm64 as :&amp;lt;sha&amp;gt; and :main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1"><mxGeometry x="570" y="385" width="400" height="85" as="geometry"/></mxCell>
        <mxCell id="sonar" value="&lt;b&gt;sonarqube&lt;/b&gt; (no needs: starts in parallel)&lt;br&gt;compile all services → SonarQube Cloud scan, waits for the quality gate&lt;br&gt;&lt;i&gt;skips green when SONAR_TOKEN / SONAR_ORGANIZATION / SONAR_PROJECT_KEY are not set (not configured yet)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="570" y="535" width="400" height="100" as="geometry"/></mxCell>
        <mxCell id="ci-gate" value="&lt;b&gt;ci&lt;/b&gt;&lt;br&gt;aggregate gate&lt;br&gt;if: always()&lt;br&gt;fails on failure&lt;br&gt;or cancelled" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1060" y="250" width="190" height="170" as="geometry"/></mxCell>
        <mxCell id="ci-note" value="needs: changes, tests, images, contracts, frontend, sonarqube. A skipped job passes. &lt;b&gt;ci&lt;/b&gt; is the single check to require on main." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1040" y="470" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="ghcr" value="&lt;b&gt;GitHub Container Registry&lt;/b&gt;&lt;br&gt;ghcr.io/microservices-happens/&amp;lt;image&amp;gt;&lt;br&gt;tags :&amp;lt;sha&amp;gt; and :main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1340" y="160" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="deploy-note" value="&lt;b&gt;No workflow deploys.&lt;/b&gt; The local cluster (kubernetes/) runs :main with imagePullPolicy Always; a developer picks up a new image with &lt;i&gt;kubectl rollout restart&lt;/i&gt;. Pull requests build and scan images but never push." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;size=14;" parent="1" vertex="1"><mxGeometry x="1340" y="290" width="500" height="70" as="geometry"/></mxCell>
        <mxCell id="art-note" value="&lt;b&gt;Artifacts&lt;/b&gt;: reports-&amp;lt;svc&amp;gt; (7 days), asyncapi-html (14 days)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="1340" y="395" width="500" height="30" as="geometry"/></mxCell>
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="t-ci" target="changes" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c2" value="services ≠ []" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="changes" target="tests" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c3" value="services ≠ []" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="changes" target="images" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c4" value="contracts/** changed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="changes" target="contracts" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c5" value="frontend/** changed&lt;br&gt;or services = all" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="changes" target="frontend" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c6" value="always" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="t-ci" target="sonar" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="tests" target="ci-gate" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="images" target="ci-gate" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="contracts" target="ci-gate" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="frontend" target="ci-gate" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="sonar" target="ci-gate" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d6b656;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="changes" target="ci-gate" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="20"/><mxPoint x="1155" y="20"/></Array></mxGeometry></mxCell>
        <mxCell id="p1" value="push: main / dispatch on main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#666666;dashed=1;dashed=0;strokeColor=#b85450;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" parent="1" source="images" target="ghcr" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#666666;dashed=1;dashed=0;strokeColor=#b85450;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" parent="1" source="frontend" target="ghcr" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="453"/><mxPoint x="1300" y="224"/></Array></mxGeometry></mxCell>
        <mxCell id="g-codeql" value="&lt;b&gt;codeql.yml&lt;/b&gt; — workflow &lt;i&gt;codeql&lt;/i&gt; (not part of the ci gate)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;labelBackgroundColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="710" width="1860" height="120" as="geometry"/></mxCell>
        <mxCell id="t-codeql" value="&lt;b&gt;on&lt;/b&gt;&lt;br&gt;pull_request · push: main&lt;br&gt;schedule Mon 05:00 UTC" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="745" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="codeql" value="&lt;b&gt;analyze java&lt;/b&gt;&lt;br&gt;CodeQL init (java-kotlin, build-mode manual) → mvn compile services/* and functions/* → analyze → Security › Code scanning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="260" y="745" width="710" height="70" as="geometry"/></mxCell>
        <mxCell id="q1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="t-codeql" target="codeql" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g-sys" value="&lt;b&gt;system-tests.yml&lt;/b&gt; — workflow &lt;i&gt;system-tests&lt;/i&gt; (cross-service cooperation tests)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;labelBackgroundColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="850" width="1860" height="140" as="geometry"/></mxCell>
        <mxCell id="t-sys" value="&lt;b&gt;on&lt;/b&gt;&lt;br&gt;push: main&lt;br&gt;schedule 02:00 UTC daily&lt;br&gt;workflow_dispatch" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="880" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="build-images" value="&lt;b&gt;build image (matrix)&lt;/b&gt;&lt;br&gt;identity-, workforce-, leave-, scheduling-, ai-service&lt;br&gt;docker build → docker save → artifact image-&amp;lt;svc&amp;gt; (not pushed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="260" y="885" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="coop" value="&lt;b&gt;cooperation tests&lt;/b&gt;&lt;br&gt;download + docker load all images → mvn verify tests/cooperation (services + RabbitMQ in containers, COOPERATION_REQUIRE_IMAGES=true) → artifact cooperation-reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="760" y="885" width="560" height="80" as="geometry"/></mxCell>
        <mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="t-sys" target="build-images" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2" value="needs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="build-images" target="coop" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g-night" value="&lt;b&gt;nightly-shift-risk.yml&lt;/b&gt; — workflow &lt;i&gt;nightly-shift-risk&lt;/i&gt; (scheduled domain report)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=13;labelBackgroundColor=#ffffff;" parent="1" vertex="1"><mxGeometry x="20" y="1010" width="1860" height="140" as="geometry"/></mxCell>
        <mxCell id="t-night" value="&lt;b&gt;on&lt;/b&gt;&lt;br&gt;schedule 03:00 UTC daily&lt;br&gt;workflow_dispatch&lt;br&gt;(horizon_days, create_issue)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1"><mxGeometry x="40" y="1040" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="report" value="&lt;b&gt;shift risk report&lt;/b&gt;&lt;br&gt;service container mysql:8.0 → load monolith schema + seed (docker/init) + demo findings → tests/schedule-report/run-report.sh → artifact schedule-risk-report (30 days)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1"><mxGeometry x="260" y="1045" width="760" height="80" as="geometry"/></mxCell>
        <mxCell id="issue" value="&lt;b&gt;GitHub issue&lt;/b&gt;&lt;br&gt;“Nightly shift risk report”&lt;br&gt;created or commented" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1120" y="1045" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="n1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="t-night" target="report" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n2" value="only if create_issue = true&lt;br&gt;(manual input)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#666666;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="report" target="issue" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="footer" value="All jobs run on ubuntu-latest. The Maven cache key m2-&amp;lt;os&amp;gt;-jdk21-v1 is shared by tests, sonarqube and codeql; Docker layers use the GitHub Actions cache per service." style="text;html=1;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="20" y="1165" width="1500" height="30" as="geometry"/></mxCell>
      </root>
