        <mxCell id="title" value="Shift Happens — Microservice Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="420" y="-110" width="800" height="40" as="geometry"/></mxCell>
