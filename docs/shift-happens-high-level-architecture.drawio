        <mxCell id="rabbit" value="&lt;b&gt;RabbitMQ&lt;/b&gt; · topic exchange &lt;i&gt;shift-happens.events&lt;/i&gt;&lt;br&gt;routing key = eventType · one durable queue per consumer · DLX" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" parent="1" vertex="1"><mxGeometry x="590" y="590" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="notifications" value="&lt;b&gt;Notification Service&lt;/b&gt;&lt;br&gt;In-app notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1"><mxGeometry x="230" y="760" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="notification-db" value="&lt;b&gt;Notification DB&lt;/b&gt;&lt;br&gt;Postgres" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="870" width="120" height="80" as="geometry"/></mxCell>
        <mxCell id="email-function" value="&lt;b&gt;email-function&lt;/b&gt; (serverless)&lt;br&gt;KEDA ScaledJob on queue email.send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="230" y="880" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="smtp" value="&lt;b&gt;SMTP&lt;/b&gt; · Mailpit locally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1"><mxGeometry x="230" y="985" width="230" height="45" as="geometry"/></mxCell>
        <mxCell id="ai" value="&lt;b&gt;AI Service&lt;/b&gt;&lt;br&gt;Replacement suggestions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1"><mxGeometry x="700" y="760" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="ai-db" value="&lt;b&gt;AI DB&lt;/b&gt;&lt;br&gt;Postgres" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="650" y="870" width="110" height="80" as="geometry"/></mxCell>
        <mxCell id="ollama" value="&lt;b&gt;Ollama&lt;/b&gt;&lt;br&gt;local LLM (llama3.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" parent="1" vertex="1"><mxGeometry x="800" y="880" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Audit Service&lt;/b&gt;&lt;br&gt;Append-only · Idempotent by eventId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1070" y="760" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="audit-db" value="&lt;b&gt;Audit Store&lt;/b&gt;&lt;br&gt;Postgres" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1115" y="870" width="150" height="80" as="geometry"/></mxCell>
        <mxCell id="legend" value='&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color="#6c8ebf"&gt;&lt;b&gt;Blue&lt;/b&gt;&lt;/font&gt;: REST /api/v1 (frontend → service)&lt;br&gt;&lt;font color="#9673a6"&gt;&lt;b&gt;Purple&lt;/b&gt;&lt;/font&gt;: GraphQL /api/graphql&lt;br&gt;&lt;font color="#b85450"&gt;&lt;b&gt;Red dashed&lt;/b&gt;&lt;/font&gt;: RabbitMQ events (service ↔ service)&lt;br&gt;&lt;b&gt;Grey dashed&lt;/b&gt;: OAuth 2.0 / OpenID Connect&lt;br&gt;Green: microservices (7) · Orange: event-driven support services&lt;br&gt;Purple cylinders: data owned by one service&lt;br&gt;&lt;br&gt;&lt;b&gt;Patterns&lt;/b&gt;&lt;br&gt;• Database per service, no sync service-to-service calls&lt;br&gt;• CQRS: Scheduling (GraphQL read side), Leave&lt;br&gt;• Saga with compensation: leave approval&lt;br&gt;• Snapshot events + balance snapshots&lt;br&gt;• Tombstones on delete · immutable leave ledger&lt;br&gt;• Idempotency-Key on POST, eventId dedupe&lt;br&gt;• Commutative handlers (highest aggregateVersion wins)&lt;br&gt;• Transactional outbox · serverless function&lt;br&gt;&lt;br&gt;Contracts: /contracts (OpenAPI · GraphQL · AsyncAPI)' style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="1390" y="-40" width="330" height="400" as="geometry"/></mxCell>
        <mxCell id="saga-note" value="&lt;b&gt;Leave-approval saga&lt;/b&gt;&lt;br&gt;1. Leave: APPROVAL_PENDING + ledger RESERVATION → &lt;i&gt;approval-started&lt;/i&gt;&lt;br&gt;2. Scheduling releases overlapping assignments → &lt;i&gt;leave-release.completed&lt;/i&gt; | &lt;i&gt;rejected&lt;/i&gt; (locked shift)&lt;br&gt;3a. completed → APPROVED&lt;br&gt;3b. rejected / timeout → compensate: ledger REVERSAL + REJECTED" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="1390" y="390" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="ai-note" value="&lt;b&gt;AI workflow&lt;/b&gt;: shift becomes understaffed → &lt;i&gt;shift.understaffed&lt;/i&gt; (with candidates) → AI Service asks the LLM to rank them → &lt;i&gt;ai.replacement.suggested&lt;/i&gt; → shown in GraphQL + notification. Advisory only; rule-based fallback if the LLM is down." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="1390" y="540" width="330" height="100" as="geometry"/></mxCell>
