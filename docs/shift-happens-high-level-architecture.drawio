        <mxCell id="leave-write-db" value="&lt;b&gt;Write&lt;/b&gt;&lt;br&gt;Requests + Ledger&lt;br&gt;Postgres + Outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1035" y="410" width="125" height="90" as="geometry"/></mxCell>
