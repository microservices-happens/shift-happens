        <mxCell id="gateway" value="&lt;b&gt;API Gateway (Caddy · K8s Ingress)&lt;/b&gt;&lt;br&gt;TLS · routing only, no business logic&lt;br&gt;/api/v1/* → REST · /api/graphql → GraphQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1"><mxGeometry x="620" y="95" width="400" height="80" as="geometry"/></mxCell>
