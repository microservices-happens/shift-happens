elative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E07A00;fontColor=#8a4b00;" parent="1" source="sb" target="job" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="SMTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="job" target="acs" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="push image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8250DF;dashed=1;dashPattern=1 3;fontColor=#5a2ea6;" parent="1" source="gha" target="acr" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8250DF;dashed=1;dashPattern=1 3;fontColor=#5a2ea6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.136;entryY=1;entryDx=0;entryDy=0;" parent="1" source="acr" target="aks" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;dashed=1;fontColor=#444444;" parent="1" source="data" target="dr" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note0" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Elasticity&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Services scale out on CPU and queue length&lt;br&gt;• Nodes added automatically&lt;br&gt;• Email function scales to zero&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="40" y="895" width="415" height="110" as="geometry"/></mxCell><mxCell id="note1" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;High availability&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Everything spread over 3 zones&lt;br&gt;• Managed databases fail over automatically&lt;br&gt;• Paired region for disaster recovery&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="475" y="895" width="415" height="110" as="geometry"/></mxCell><mxCell id="note2" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Low latency&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Region close to Danish users&lt;br&gt;• Front Door caches at the edge&lt;br&gt;• Reads from pre-computed read models&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="910" y="895" width="415" height="110" as="geometry"/></mxCell><mxCell id="note3" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;Security&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• WAF in front of everything&lt;br&gt;• No public database endpoints&lt;br&gt;• Secrets in Key Vault&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1"><mxGeometry x="1345" y="895" width="415" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram>
