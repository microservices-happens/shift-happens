mg/lib/azure2/networking/Private_Endpoint.svg;" parent="snet-pe" vertex="1"><mxGeometry x="36" y="705" width="48" height="48" as="geometry"/></mxCell><mxCell id="pe-t" value="One private endpoint + private DNS zone per PaaS resource. Public network access disabled." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;align=center;fontColor=#1f4e79;fontSize=10;" parent="snet-pe" vertex="1"><mxGeometry x="5" y="845" width="110" height="95" as="geometry"/></mxCell><mxCell id="paas" value="Managed messaging, data, AI and secrets (PaaS)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#F7F9FC;strokeColor=#b7c7da;fontColor=#333333;" parent="region" vertex="1"><mxGeometry x="1470" y="40" width="300" height="1000" as="geometry"/></mxCell><mxCell id="sb" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/integration/Service_Bus.svg;" parent="paas" vertex="1"><mxGeometry x="15" y="45" width="48" height="48" as="geometry"/></mxCell><mxCell id="sb-t" value="&lt;b&gt;Azure Service Bus (Premium)&lt;/b&gt;&lt;br&gt;topic &lt;i&gt;shift-happens-events&lt;/i&gt; · one subscription per consumer, filter on eventType · 3 deliveries → DLQ · zone-redundant" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="paas" vertex="1"><mxGeometry x="71" y="37" width="225" height="92" as="geometry"/></mxCell><mxCell id="pg1" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" parent="paas" vertex="1"><mxGeometry x="15" y="185" width="48" height="48" as="geometry"/></mxCell><mxCell id="pg1-t" value="&lt;b&gt;PostgreSQL Flexible Server · pg-transactional&lt;/b&gt;&lt;br&gt;scheduling-write, leave-write · zone-redundant HA (sync standby, auto failover) · PITR" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="paas" vertex="1"><mxGeometry x="71" y="177" width="225" height="92" as="geometry"/></mxCell><mxCell id="pg2" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" parent="paas" vertex="1"><mxGeometry x="15" y="325" width="48" height="48" as="geometry"/></mxCell><mxCell id="pg2-t" value="&lt;b&gt;PostgreSQL Flexible Server · pg-shared&lt;/b&gt;&lt;br&gt;identity, workforce, notification, audit, ai · own database + login per service · zone-redundant HA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="paas" vertex="1"><mxGeometry x="71" y="317" width="225" height="92" as="geometry"/></mxCell><mxCell id="cosmos" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;" parent="paas" vertex="1"><mxGeometry x="15" y="465" width="48" height="48" as="geometry"/></mxCell><mxCell id="cosmos-t" value="&lt;b&gt;Cosmos DB for MongoDB (vCore)&lt;/b&gt;&lt;br&gt;scheduling-read, leave-read models · HA replica · rebuildable from events" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="paas" vertex="1"><mxGeometry x="71" y="457" width="225" height="92" as="geometry"/></mxCell><mxCell id="aoai" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" parent="paas" vertex="1"><mxGeometry x="15" y="605" width="48" height="48" as="geometry"/></mxCell><mxCell id="aoai-t" value="&lt;b&gt;Azure OpenAI&lt;/b&gt;&lt;br&gt;Small hosted model through Spring AI (replaces Ollama); rule-based fallback stays" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="paas" vertex="1"><mxGeometry x="71" y="597" width="225" height="92" as="geometry"/></mxCell><mxCell id="kv" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/security/Key_Vaults.svg;" parent="paas" vertex="1"><mxGeometry x="15" y="745" width="48" height="48" as="geometry"/></mxCell><mxCell id="kv-t" value="&lt;b&gt;Key Vault&lt;/b&gt;&lt;br&gt;JWT signing key, DB credentials, OIDC client secrets · read via Workload Identity" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="paas" vertex="1"><mxGeometry x="71" y="737" width="225" height="92" as="geometry"/></mxCell><mxCell id="dr" value="Region North Europe (paired, disaster recovery)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#0078D4;dashed=1;fontColor=#0078D4;" parent="sub" vertex="1"><mxGeometry x="1820" y="170" width="275" height="690" as="geometry"/></mxCell><mxCell id="dr-pg" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" parent="dr" vertex="1"><mxGeometry x="12" y="60" width="48" height="48" as="geometry"/></mxCell><mxCell id="dr-pg-t" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;geo-redundant backups, optional read replica" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="dr" vertex="1"><mxGeometry x="68" y="52" width="200" height="70" as="geometry"/></mxCell><mxCell id="dr-acr" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/containers/Container_Registries.svg;" parent="dr" vertex="1"><mxGeometry x="12" y="180" width="48" height="48" as="geometry"/></mxCell><mxCell id="dr-acr-t" value="&lt;b&gt;Container Registry&lt;/b&gt;&lt;br&gt;geo-replica, so images can be pulled during an outage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="dr" vertex="1"><mxGeometry x="68" y="172" width="200" height="70" as="geometry"/></mxCell><mxCell id="dr-cosmos" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;" parent="dr" vertex="1"><mxGeometry x="12" y="300" width="48" height="48" as="geometry"/></mxCell><mxCell id="dr-cosmos-t" value="&lt;b&gt;Cosmos DB&lt;/b&gt;&lt;br&gt;optional replica (also lowers read latency)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="dr" vertex="1"><mxGeometry x="68" y="292" width="200" height="70" as="geometry"/></mxCell><mxCell id="dr-sb" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/integration/Service_Bus.svg;" parent="dr" vertex="1"><mxGeometry x="12" y="420" width="48" height="48" as="geometry"/></mxCell><mxCell id="dr-sb-t" value="&lt;b&gt;Service Bus&lt;/b&gt;&lt;br&gt;geo-replicated namespace, promoted on failover" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="dr" vertex="1"><mxGeometry x="68" y="412" width="200" height="70" as="geometry"/></mxCell><mxCell id="dr-t" value="&lt;b&gt;Recovery:&lt;/b&gt; the same IaC recreates AKS and the Container Apps environment here; Front Door switches origin on failed health probes. Target RPO ≤ 15 min, RTO ≤ 4 h." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="dr" vertex="1"><mxGeometry x="12" y="520" width="255" height="140" as="geometry"/></mxCell><mxCell id="e-users-afd" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="users" target="afd" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-afd-spa" value="/* static SPA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="afd" target="spa" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="285"/></Array></mxGeometry></mxCell><mxCell id="e-afd-agc" value="/api/v1/* (REST) · /api/graphql" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="afd" target="agc" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-agc-apps" value="path routing to Services" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="agc" target="ns-apps" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-id-oidc" value="OIDC (outbound)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="identity" target="oidc" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="680"/><mxPoint x="580" y="175"/><mxPoint x="1565" y="175"/></Array></mxGeometry></mxCell><mxCell id="e-apps-sb" value="AMQP 1.0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E07A00;fontColor=#8a4b00;startArrow=block;startFill=1;exitX=0.977;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ns-apps" target="pe-sb" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="469"/></Array></mxGeometry></mxCell><mxCell id="e-pesb-sb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E07A00;fontColor=#8a4b00;startArrow=block;startFill=1;" parent="1" source="pe-sb" target="sb" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-sb-email" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E07A00;fontColor=#8a4b00;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="sb" target="email" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1710" y="486"/><mxPoint x="1710" y="1202"/><mxPoint x="1080" y="1202"/></Array></mxGeometry></mxCell><mxCell id="e-email-acs" value="SMTP (TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="email" target="acs" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-apps-pe" value="JDBC / MongoDB / HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;dashed=1;fontColor=#444444;" parent="1" source="ns-apps" target="snet-pe" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pe-pg1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;dashed=1;fontColor=#444444;" parent="1" source="pe-pg1" target="pg1" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pe-pg2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;dashed=1;fontColor=#444444;" parent="1" source="pe-pg2" target="pg2" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pe-cosmos" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;dashed=1;fontColor=#444444;" parent="1" source="pe-cosmos" target="cosmos" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pe-aoai" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;dashed=1;fontColor=#444444;" parent="1" source="pe-aoai" target="aoai" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pe-kv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;dashed=1;fontColor=#444444;" parent="1" source="pe-kv" target="kv" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-paas-dr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;dashed=1;fontColor=#444444;" parent="1" source="paas" target="dr" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-gha-acr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8250DF;dashed=1;dashPattern=1 3;fontColor=#5a2ea6;" parent="1" source="gha" target="acr" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-acr-aks" value="pull (AcrPull identity)&lt;br&gt;Flux GitOps applies releases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8250DF;dashed=1;dashPattern=1 3;fontColor=#5a2ea6;" parent="1" source="acr" target="aks" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-otel-mon" value="metrics · logs · traces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8250DF;dashed=1;dashPattern=1 3;fontColor=#5a2ea6;" parent="1" source="otel" target="mon" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note0" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;Elasticity&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• HPA scales the query roles and identity on CPU (2 → 10 pods).&lt;br&gt;• KEDA scales event consumers (notification, audit, ai, projections) on Service Bus backlog.&lt;br&gt;• Cluster Autoscaler grows the user node pool (3 → 12 nodes, across all zones).&lt;br&gt;• email-function is a Container Apps Job: 0 instances when idle, up to 5 under load.&lt;br&gt;• CQRS lets command and query sides scale independently.&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="230" y="1480" width="510" height="190" as="geometry"/></mxCell><mxCell id="note1" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;High availability&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• ≥ 2 replicas per Deployment, spread over 3 availability zones, with PDBs and rolling updates.&lt;br&gt;• Service Bus Premium is zone-redundant; failed messages go to the dead-letter queue, and the outbox keeps events if the bus is unreachable.&lt;br&gt;• PostgreSQL zone-redundant HA with automatic failover; Cosmos vCore HA replica.&lt;br&gt;• No synchronous calls between services, so one failing service does not cascade.&lt;br&gt;• Paired region North Europe for disaster recovery.&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="760" y="1480" width="510" height="190" as="geometry"/></mxCell><mxCell id="note2" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;Low latency&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• West Europe is close to Danish users (~20 ms round trip).&lt;br&gt;• Front Door terminates TLS at the nearest edge and caches the SPA.&lt;br&gt;• Schedule and leave views read from precomputed MongoDB read models.&lt;br&gt;• Services, Service Bus and databases share one region; Private Link keeps traffic on the Azure backbone.&lt;br&gt;• If users spread out: Cosmos read replicas in more regions; writes stay in West Europe.&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="1290" y="1480" width="510" height="190" as="geometry"/></mxCell><mxCell id="note3" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;Security and operations&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• WAF at the edge; the gateway only accepts traffic from our Front Door profile.&lt;br&gt;• No public endpoints on Service Bus, databases, Key Vault or OpenAI; NSGs + Cilium network policies.&lt;br&gt;• Workload Identity instead of connection strings; secrets in Key Vault; every service validates the RS256 JWT.&lt;br&gt;• OpenTelemetry → Azure Monitor: dashboards and alerts on errors, latency, queue depth and DLQ size.&lt;br&gt;• Infrastructure as code; GitHub Actions and Flux deploy with federated identities.&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1"><mxGeometry x="1820" y="1480" width="510" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="rollout-plan" name="Rollout and release plan"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2360" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="Deployment plan" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="0" width="1400" height="40" as="geometry"/></mxCell><mxCell id="sub2" value="Rollout and release · phases run in order, each ends with an exit check" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="40" y="38" width="1400" height="26" as="geometry"/></mxCell><mxCell id="pipe" value="Release pipeline (every merge to main)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#F7F9FC;strokeColor=#b7c7da;fontSize=14;" parent="1" vertex="1"><mxGeometry x="40" y="80" width="2280" height="200" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;feat/fix branch&lt;br&gt;review by owners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="pipe" vertex="1"><mxGeometry x="20" y="50" width="270" height="110" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;CI (GitHub Actions)&lt;/b&gt;&lt;br&gt;build · unit · *IT (Testcontainers)&lt;br&gt;cooperation tests · Sonar · CodeQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="pipe" vertex="1"><mxGeometry x="342" y="50" width="270" height="110" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Image&lt;/b&gt;&lt;br&gt;Trivy scan, then push to ACR&lt;br&gt;tag: semver + git SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="pipe" vertex="1"><mxGeometry x="664" y="50" width="270" height="110" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Staging (Azure)&lt;/b&gt;&lt;br&gt;Flux applies the new tag&lt;br&gt;smaller SKUs, single zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="pipe" vertex="1"><mxGeometry x="986" y="50" width="270" height="110" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;Smoke + cooperation tests&lt;/b&gt;&lt;br&gt;leave saga, understaffed → AI,&lt;br&gt;login through Front Door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="pipe" vertex="1"><mxGeometry x="1308" y="50" width="270" height="110" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;Manual approval&lt;/b&gt;&lt;br&gt;GitHub environment&lt;br&gt;protection rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="pipe" vertex="1"><mxGeometry x="1630" y="50" width="270" height="110" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b&gt;Production&lt;/b&gt;&lt;br&gt;rolling update per service&lt;br&gt;rollback = previous tag in Git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="pipe" vertex="1"><mxGeometry x="1952" y="50" width="270" height="110" as="geometry"/></mxCell><mxCell id="pe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="p1" target="p2" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="p2" target="p3" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="p3" target="p4" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="p4" target="p5" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="p5" target="p6" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="p6" target="p7" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="phases" value="Implementation phases" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=12;fillColor=none;strokeColor=none;fontSize=14;" parent="1" vertex="1"><mxGeometry x="40" y="300" width="2280" height="360" as="geometry"/></mxCell><mxCell id="ph0" value="&lt;b&gt;Phase 0 · Foundation&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=24;fillColor=#E6F2FB;strokeColor=#6c8ebf;fontSize=13;" parent="phases" vertex="1"><mxGeometry x="0" y="40" width="360" height="56" as="geometry"/></mxCell><mxCell id="ph0-b" value="• Subscription, resource groups, budgets&lt;br&gt;• VNet, subnets, NSGs, private DNS zones&lt;br&gt;• Key Vault, Log Analytics, Container Registry&lt;br&gt;• GitHub OIDC federation (no stored secrets)&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" parent="phases" vertex="1"><mxGeometry x="0" y="110" width="360" height="140" as="geometry"/></mxCell><mxCell id="ph0-x" value="&lt;b&gt;Exit check&lt;/b&gt;&lt;br&gt;IaC plan applies cleanly; CI can push to ACR" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#E6F2FB;strokeColor=#6c8ebf;" parent="phases" vertex="1"><mxGeometry x="0" y="265" width="360" height="80" as="geometry"/></mxCell><mxCell id="ph1" value="&lt;b&gt;Phase 1 · Platform&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=24;fillColor=#E6F2FB;strokeColor=#6c8ebf;fontSize=13;" parent="phases" vertex="1"><mxGeometry x="384" y="40" width="360" height="56" as="geometry"/></mxCell><mxCell id="ph1-b" value="• AKS across 3 zones: system + user pools&lt;br&gt;• CNI Overlay + Cilium, Workload Identity&lt;br&gt;• KEDA add-on, Flux GitOps, Managed Prometheus/Grafana&lt;br&gt;• App Gateway for Containers, Container Apps env&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" parent="phases" vertex="1"><mxGeometry x="384" y="110" width="360" height="140" as="geometry"/></mxCell><mxCell id="ph1-x" value="&lt;b&gt;Exit check&lt;/b&gt;&lt;br&gt;Test pod reachable through the gateway; dashboards show node metrics" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#E6F2FB;strokeColor=#6c8ebf;" parent="phases" vertex="1"><mxGeometry x="384" y="265" width="360" height="80" as="geometry"/></mxCell><mxCell id="ph2" value="&lt;b&gt;Phase 2 · Data and messaging&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=24;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="phases" vertex="1"><mxGeometry x="768" y="40" width="360" height="56" as="geometry"/></mxCell><mxCell id="ph2-b" value="• PostgreSQL pg-transactional + pg-shared (DB + login per service)&lt;br&gt;• Cosmos DB for MongoDB vCore (2 read models)&lt;br&gt;• Service Bus Premium: topic, one subscription per consumer, DLQ&lt;br&gt;• Azure OpenAI deployment, Communication Services Email&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" parent="phases" vertex="1"><mxGeometry x="768" y="110" width="360" height="140" as="geometry"/></mxCell><mxCell id="ph2-x" value="&lt;b&gt;Exit check&lt;/b&gt;&lt;br&gt;Flyway migrates every DB from empty; a test event reaches every subscription, a poison message lands in the DLQ" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" parent="phases" vertex="1"><mxGeometry x="768" y="265" width="360" height="80" as="geometry"/></mxCell><mxCell id="ph3" value="&lt;b&gt;Phase 3 · Workloads&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=24;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="phases" vertex="1"><mxGeometry x="1152" y="40" width="360" height="56" as="geometry"/></mxCell><mxCell id="ph3-b" value="• Messaging adapter: Spring AMQP → Spring Cloud Azure Service Bus (same envelope and eventType)&lt;br&gt;• Helm charts built from kubernetes/&lt;br&gt;• Deploy order: identity → workforce → scheduling and leave (command before query) → ai, notification, audit&lt;br&gt;• email-function as Container Apps Job&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" parent="phases" vertex="1"><mxGeometry x="1152" y="110" width="360" height="140" as="geometry"/></mxCell><mxCell id="ph3-x" value="&lt;b&gt;Exit check&lt;/b&gt;&lt;br&gt;Cooperation smoke tests pass in staging" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" parent="phases" vertex="1"><mxGeometry x="1152" y="265" width="360" height="80" as="geometry"/></mxCell><mxCell id="ph4" value="&lt;b&gt;Phase 4 · Edge and go-live&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=24;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" parent="phases" vertex="1"><mxGeometry x="1536" y="40" width="360" height="56" as="geometry"/></mxCell><mxCell id="ph4-b" value="• SPA to Storage static website&lt;br&gt;• Front Door + WAF, custom domain, managed TLS&lt;br&gt;• OIDC redirect URIs for Google/GitHub&lt;br&gt;• One-time import of monolith data, then cutover&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" parent="phases" vertex="1"><mxGeometry x="1536" y="110" width="360" height="140" as="geometry"/></mxCell><mxCell id="ph4-x" value="&lt;b&gt;Exit check&lt;/b&gt;&lt;br&gt;Smoke tests on the public URL; rollback plan rehearsed" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" parent="phases" vertex="1"><mxGeometry x="1536" y="265" width="360" height="80" as="geometry"/></mxCell><mxCell id="ph5" value="&lt;b&gt;Phase 5 · Operate and harden&lt;/b&gt;" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=24;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" parent="phases" vertex="1"><mxGeometry x="1920" y="40" width="360" height="56" as="geometry"/></mxCell><mxCell id="ph5-b" value="• Load test to tune HPA/KEDA thresholds&lt;br&gt;• Alerts: errors, latency, queue depth, DLQ, saga timeouts, LLM fallback&lt;br&gt;• Disaster-recovery drill in North Europe&lt;br&gt;• Cost review: right-size SKUs, reservations&lt;br&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" parent="phases" vertex="1"><mxGeometry x="1920" y="110" width="360" height="140" as="geometry"/></mxCell><mxCell id="ph5-x" value="&lt;b&gt;Exit check&lt;/b&gt;&lt;br&gt;SLO dashboard green for 2 weeks; DR drill within RTO" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="phases" vertex="1"><mxGeometry x="1920" y="265" width="360" height="80" as="geometry"/></mxCell><mxCell id="map-h" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;Local → Azure mapping&lt;/font&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="690" width="600" height="30" as="geometry"/></mxCell><mxCell id="map" value="&lt;table style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr&gt;&lt;th style='border:1px solid #b7c7da;padding:4px 8px;background:#E6F2FB;text-align:left'&gt;Concern&lt;/th&gt;&lt;th style='border:1px solid #b7c7da;padding:4px 8px;background:#E6F2FB;text-align:left'&gt;Local today&lt;/th&gt;&lt;th style='border:1px solid #b7c7da;padding:4px 8px;background:#E6F2FB;text-align:left'&gt;Azure target&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;API gateway&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Caddy (Compose) · NGINX Ingress (local K8s)&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Front Door + WAF → Application Gateway for Containers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;Frontend&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;frontend container&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Storage static website, cached by Front Door&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;Services (7, plus CQRS roles)&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;containers / Deployments&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;AKS Deployments (same services and env-var config)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;PostgreSQL write databases (7)&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;postgres:17 containers&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Azure Database for PostgreSQL Flexible Server (2 servers, 1 DB per service)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;MongoDB read models (2)&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;mongo:8 containers&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Cosmos DB for MongoDB (vCore)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;Message broker&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;RabbitMQ: topic exchange, queue per consumer, DLX&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Azure Service Bus Premium: topic, subscription per consumer (SQL filter on eventType), built-in DLQ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;Serverless email&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;KEDA ScaledJob (rabbitmq trigger)&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Container Apps Job with KEDA azure-servicebus scaler&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;SMTP&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Mailpit&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Azure Communication Services Email&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;LLM&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Ollama (llama3.2:1b)&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Azure OpenAI through Spring AI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;Images&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;GHCR&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Azure Container Registry (geo-replicated)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;Secrets&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Kubernetes Secrets from create-secrets.sh&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;Key Vault + Secrets Store CSI + Workload Identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;&lt;b&gt;Observability&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;otel-collector → Prometheus, Loki, Tempo, Grafana&lt;/td&gt;&lt;td style='border:1px solid #d0d7e0;padding:4px 8px;text-align:left'&gt;otel-collector → Azure Monitor, Managed Prometheus/Grafana&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;" parent="1" vertex="1"><mxGeometry x="40" y="725" width="1400" height="400" as="geometry"/></mxCell><mxCell id="env-h" value="&lt;b&gt;&lt;font style='font-size:14px'&gt;Environments&lt;/font&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;" parent="1" vertex="1"><mxGeometry x="1480" y="690" width="600" height="30" as="geometry"/></mxCell><mxCell id="env0" value="&lt;b&gt;dev&lt;/b&gt;&lt;br&gt;docker-compose on each laptop" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="1480" y="730" width="300" height="70" as="geometry"/></mxCell><mxCell id="env1" value="&lt;b&gt;test&lt;/b&gt;&lt;br&gt;CI: Testcontainers + local Kubernetes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="1480" y="830" width="300" height="70" as="geometry"/></mxCell><mxCell id="env2" value="&lt;b&gt;staging&lt;/b&gt;&lt;br&gt;Azure, small SKUs, single zone" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="1480" y="930" width="300" height="70" as="geometry"/></mxCell><mxCell id="env3" value="&lt;b&gt;prod&lt;/b&gt;&lt;br&gt;Azure, zone-redundant, DR region" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="1480" y="1030" width="300" height="70" as="geometry"/></mxCell><mxCell id="enve0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="env0" target="env1" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="enve1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="env1" target="env2" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="enve2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontColor=#0b4a80;" parent="1" source="env2" target="env3" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="env-t" value="Staging and prod are created from the same IaC modules with different parameters, so staging tests the real topology at lower cost." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;spacing=2;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1810" y="730" width="480" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram>
