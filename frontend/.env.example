# REST base URL as seen by the browser; the gateway maps /api/v1/<resource> to the owning service.
VITE_API_BASE_URL=/api/v1
# GraphQL endpoint as seen by the browser; the gateway maps /api/graphql to scheduling-query's /graphql.
VITE_GRAPHQL_URL=/api/graphql
# Only for `npm run dev`: where the Vite dev server proxies /api/* (the Compose API gateway).
VITE_DEV_PROXY_TARGET=https://localhost:8443
