# Template for the per-service Kubernetes Secrets. Copy to kubernetes/secrets/secrets.env
# (git-ignored), or let `kubernetes/secrets/create-secrets.sh --generate` copy it and fill every
# CHANGE_ME with a random value. Never commit the filled-in file.
#
# Format: KEY=value, one per line, no quotes, no spaces around "=". The variable names are the
# ones docker-compose.microservices.yml reads from .env. create-secrets.sh maps them onto the env
# var names each container uses (e.g. IDENTITY_DB_PASSWORD -> DB_PASSWORD in identity-service-secrets).
#
# Database, Mongo and RabbitMQ passwords only take effect when the data volume is first
# initialised. If your cluster already has data under the hostPath PVs, either use the passwords
# that data was created with, or wipe the data first (see kubernetes/README.md).

# Broker: rabbitmq-secrets and every consumer's secret.
RABBITMQ_PASSWORD=CHANGE_ME

# identity-service-secrets (+ identity-db)
IDENTITY_DB_PASSWORD=CHANGE_ME
# bcrypt(pepper + password). Changing it later invalidates every stored password hash.
PASSWORD_PEPPER=CHANGE_ME
# First-admin bootstrap. Both empty = off; set both or neither (password min. 8 characters).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Google/GitHub login. Empty = that provider stays disabled (client ids are set in the Deployment).
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GITHUB_CLIENT_SECRET=
# The RS256 signing key is not set here: it is read from kubernetes/secrets/jwt-private-key.pem
# (PKCS#8 PEM, git-ignored, generated by --generate).

# workforce-service-secrets (+ workforce-db)
WORKFORCE_DB_PASSWORD=CHANGE_ME

# scheduling-command-secrets (+ scheduling-write-db)
SCHEDULING_DB_PASSWORD=CHANGE_ME
# scheduling-query-secrets (+ scheduling-read-db)
SCHEDULING_MONGO_PASSWORD=CHANGE_ME

# leave-command-secrets (+ leave-write-db)
LEAVE_DB_PASSWORD=CHANGE_ME
# leave-query-secrets (+ leave-read-db)
LEAVE_MONGO_PASSWORD=CHANGE_ME

# notification-service-secrets (+ notification-db)
NOTIFICATION_DB_PASSWORD=CHANGE_ME

# audit-service-secrets (+ audit-db)
AUDIT_DB_PASSWORD=CHANGE_ME

# ai-service-secrets (+ ai-db)
AI_DB_PASSWORD=CHANGE_ME

# email-function-secrets. Empty is fine for Mailpit; set both for a real SMTP provider.
SMTP_USERNAME=
SMTP_PASSWORD=
