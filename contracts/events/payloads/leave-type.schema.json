{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shift-happens.local/contracts/events/payloads/leave-type.schema.json",
  "title": "LeaveTypeSnapshot",
  "description": "data of leave.type.created.v1 and leave.type.updated.v1 (full snapshot). Deleting a leave type publishes leave.type.deleted.v1 with a tombstone instead.",
  "type": "object",
  "required": [
    "leaveTypeId",
    "leaveTypeName",
    "leaveTypeDescription",
    "requiresApproval",
    "isPaidLeave"
  ],
  "properties": {
    "leaveTypeId": {
      "type": "integer"
    },
    "leaveTypeName": {
      "type": "string"
    },
    "leaveTypeDescription": {
      "type": [
        "string",
        "null"
      ]
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "isPaidLeave": {
      "type": "boolean"
    }
  }
}
