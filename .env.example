# ---- DB TOGGLE: keep EXACTLY ONE block uncommented ----
# (dotenv crashes on duplicate keys, so never leave two blocks active)

# Railway (cloud) — paste from Railway > MySQL service > "Connect" > Public Network.
# Use the PUBLIC proxy host/port (e.g. xxxx.proxy.rlwy.net:5xxxx), NOT *.railway.internal.
# Keep "/shift_happens" and the ?params as-is. Then comment out the Local block above.
DB_URL=jdbc:mysql://zephyr.proxy.rlwy.net:31659/shift_happens?allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=app_user
DB_PASSWORD=apppassword

# Docker (local)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=shift_happens
LOCAL_DB_USERNAME=root


# App DB user (used by docker-compose to create the MySQL app user)
APP_DB_USER=app_user
APP_DB_PASSWORD=apppassword

# Neo4j credentials (used by docker-compose)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpassword

# Security (override with strong random values in production)
JWT_SECRET=shift-happens-dev-secret-key-minimum-32-characters-long!!
PASSWORD_PEPPER=SH_SECRET_PEPPER_2024
# identity-service RS256 signing key: a PKCS#8 PEM path *inside the container*. Leave it empty for
# Compose (a key is generated at startup; tokens die on restart). Compose mounts no key file, so a path
# here makes the service fail to start. Kubernetes should mount the key as a secret file (P7.2).
JWT_PRIVATE_KEY_PATH=
# identity-service first-admin bootstrap. Both empty = off. The Administrator account with this email
# gets this password (min. 8 characters) if it has none yet; an existing password is never overwritten.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# identity-service Google/GitHub login. Empty client id = that provider is disabled.
# Register <OIDC_REDIRECT_BASE_URL>/{google|github}/callback with the provider (see services/identity-service/README.md).
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GITHUB_CLIENT_ID=
OIDC_GITHUB_CLIENT_SECRET=
